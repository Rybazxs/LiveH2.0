<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>LiveH.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>LiveH OS</ApplicationTitle>
    <ApplicationId>com.liveh.os</ApplicationId>
    <ApplicationDisplayVersion>0.0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#000000" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#000000" BaseSize="128,128" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LiveH.Contracts\LiveH.Contracts.csproj" />
    <ProjectReference Include="..\LiveH.Core\LiveH.Core.csproj" />
    <ProjectReference Include="..\LiveH.Modules.Today\LiveH.Modules.Today.csproj" />
    <ProjectReference Include="..\LiveH.Modules.Missions\LiveH.Modules.Missions.csproj" />
    <ProjectReference Include="..\LiveH.Modules.Groups\LiveH.Modules.Groups.csproj" />
  </ItemGroup>
</Project>
