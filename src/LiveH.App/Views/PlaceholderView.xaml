<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LiveH.App.Views.PlaceholderView"
             BackgroundColor="{StaticResource OsBlack}">
    <ScrollView>
        <VerticalStackLayout Padding="22,11,22,25" Spacing="13">
            <Label x:Name="PageTitle" FontSize="27" FontAttributes="Bold"
                   TextColor="{StaticResource OsCyan}" />
            <Border Padding="14,12" StrokeThickness="1" Stroke="{StaticResource OsBorder}"
                    StrokeShape="Rectangle" BackgroundColor="{StaticResource OsPanel}">
                <VerticalStackLayout Spacing="9">
                    <Label x:Name="ModuleLabel" FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource OsText}" />
                    <Label Text="Szkielet nawigacji działa. Ten moduł zostanie dodany w osobnej paczce."
                           FontSize="13" TextColor="{StaticResource OsMuted}" />
                    <Label Text="Brak fikcyjnych danych i przypadkowych zależności."
                           FontSize="12" TextColor="{StaticResource OsCyan}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
