<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LiveH.App.Views.PlaceholderView"
             BackgroundColor="{StaticResource OsBlack}">
    <ScrollView>
        <VerticalStackLayout Padding="24,28" Spacing="25">
            <Label x:Name="PageTitle" FontSize="29" FontAttributes="Bold"
                   TextColor="{StaticResource OsCyan}" />
            <Border Padding="20" StrokeThickness="1" Stroke="{StaticResource OsBorder}"
                    StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource OsPanel}">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="ModuleLabel" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource OsText}" />
                    <Label Text="Szkielet nawigacji działa. Ten moduł zostanie dodany w osobnej paczce."
                           FontSize="14" TextColor="{StaticResource OsMuted}" />
                    <Label Text="Brak fikcyjnych danych i przypadkowych zależności."
                           FontSize="12" TextColor="{StaticResource OsCyan}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
